[app]
title = Jurnal Saham IHSG
package.name = jurnalsahamihsg
package.domain = com.jurnalsaham
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,ttf,txt,json,csv
version = 0.1
requirements = python3==3.9.13,setuptools==58.0.0,kivy==2.1.0,requests
orientation = portrait
fullscreen = 0
android.ndk = 25b
android.api = 30
android.minapi = 21
android.sdk = 30
android.permissions = INTERNET

[buildozer]
log_level = 2
warn_on_root = 1
p4a.local_recipes = %(source.dir)s/recipes