venv/
.venv*/
.env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Logs & Temporary
*.log
*.txt
*.tmp
*.pid
.device_*
.kivy_*
*.buildozer*
crash_log.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# Large Files
*.keystore
*.jks
*.p12
*.pfx

# Data & Cache
data/
cache/
temp/
tmp/

# Reverse Engineering (TIDAK PERLU untuk mobile dev)
_cleanup/
_archive/
apk_mod/
decompiled_output/
extracted_apk_*/
