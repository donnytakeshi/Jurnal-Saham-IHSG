{
  "name": "Jurnal Saham Kivy Dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install kivy requests buildozer cython",
  "customizations": {
