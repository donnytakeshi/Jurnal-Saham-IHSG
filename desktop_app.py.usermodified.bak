class MainStockbitApp(App):
    def build(self):
        self.tab_names = ['Watchlist', 'Dashboard', 'Cek Saham', 'Screening', 'Investasi']
        self.tabs = [WatchlistTab(), DashboardTab(), CekSahamTab(), ScreeningTab(), InvestasiTab()]
        self.tab_icons = ['📋', '📊', '🔍', '🧮', '💼']
        self.current_tab = 0
        root = BoxLayout(orientation='vertical')
        # Top rounded header (teal) like screenshot
        from kivy.graphics import Color, RoundedRectangle
        header_box = BoxLayout(orientation='vertical', size_hint_y=None, height=110, padding=(12,12))
        with header_box.canvas.before:
            Color(0.37,0.67,0.74,1)
            header_box._bg = RoundedRectangle(pos=header_box.pos, size=header_box.size, radius=[16])
        def _upd_header_box(_, __):
            try:
                header_box._bg.pos = header_box.pos
                header_box._bg.size = header_box.size
            except Exception:
                pass
        header_box.bind(pos=_upd_header_box, size=_upd_header_box)
        header_box.add_widget(Label(text='[b]Jurnal Screening Saham IHSG[/b]', markup=True, font_size=20, color=(1,1,1,1)))
        header_box.add_widget(Label(text='v0.1.34 • android', font_size=14, color=(1,1,1,1)))
        root.add_widget(header_box)

        # Tab container (content area)
        self.tab_container = BoxLayout(orientation='vertical')
        root.add_widget(self.tab_container)
        # show initial tab (Watchlist)
        self.switch_tab(0)
        # Bottom navigation ala Stockbit (vertical icon + label buttons)
        from kivy.graphics import Color, Rectangle
        nav = BoxLayout(orientation='horizontal', size_hint_y=None, height=64, spacing=0)
        # draw background and top border
        with nav.canvas.before:
            Color(0.06, 0.06, 0.06, 1)
            nav._bg = Rectangle(pos=nav.pos, size=nav.size)
            Color(0.15, 0.15, 0.15, 1)
            nav._top = Rectangle(pos=(nav.x, nav.y + nav.height - 1), size=(nav.width, 1))
        def _update_nav(_, __):
            nav._bg.pos = nav.pos
            nav._bg.size = nav.size
            nav._top.pos = (nav.x, nav.y + nav.height - 1)
            nav._top.size = (nav.width, 1)
        nav.bind(pos=_update_nav, size=_update_nav)

        nav_buttons = []
        def make_nav(icon_text, label_text, handler, active=False):
            b = Button(background_normal='', background_color=(0,0,0,0), size_hint_x=1)
            box = BoxLayout(orientation='vertical', padding=(0,6))
            icon = Label(text=icon_text, font_size=22, size_hint_y=None, height=28, color=(0.7,0.7,0.7,1))
            txt = Label(text=label_text, font_size=11, size_hint_y=None, height=18, color=(0.7,0.7,0.7,1))
            box.add_widget(icon)
            box.add_widget(txt)
            b.add_widget(box)

            def set_active(state: bool):
                if state:
                    # active color (green-ish like Stockbit)
                    icon.color = (0.11, 0.75, 0.36, 1)
                    txt.color = (0.11, 0.75, 0.36, 1)
                    b.background_color = (0.11, 0.75, 0.36, 0.08)
                else:
                    icon.color = (0.7,0.7,0.7,1)
                    txt.color = (0.7,0.7,0.7,1)
                    b.background_color = (0,0,0,0)

            def _on_press(instance, *_):
                for other in nav_buttons:
                    try:
                        other.set_active(False)
                    except Exception:
                        pass
                set_active(True)
                try:
                    handler()
                except Exception:
                    pass

            b.set_active = set_active
            b.bind(on_press=_on_press)
            set_active(active)
            nav_buttons.append(b)
            return b

        # choose icons (emoji fallback)
        icons = ['⭐', '🏠', '🔍', '💬', '📈']
        labels = self.tab_names
        handlers = [lambda: self.switch_tab(0), lambda: self.switch_tab(1), lambda: self.switch_tab(2), lambda: self.switch_tab(3), lambda: self.switch_tab(4)]

        for i in range(len(labels)):
            btn = make_nav(icons[i], labels[i], handlers[i], active=(i==self.current_tab))
            nav.add_widget(btn)

        root.add_widget(nav)
        return root
    def switch_tab(self, idx):
        self.tab_container.clear_widgets()
        self.tab_container.add_widget(self.tabs[idx])
        self.current_tab = idx

# Entry point for main.py
JurnalSahamApp = MainStockbitApp
