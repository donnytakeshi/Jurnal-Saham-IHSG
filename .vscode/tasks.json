{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cleanup: safe (archive)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"scripts/cleanup_project.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "cleanup: hard (delete)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"scripts/cleanup_project.py",
				"--hard"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Run Kivy Desktop App",
			"type": "shell",
			"command": "python",
			"args": [
				"desktop_app.py"
			],
			"isBackground": false,
			"problemMatcher": [
				"$python"
			],
			"group": "build"
		},
		{
			"label": "Build Distribution",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$python"
			],
			"group": "build"
		}
	]
}