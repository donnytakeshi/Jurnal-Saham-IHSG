
# --- Stockbit-style Bottom Navigation App ---

from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.scrollview import ScrollView
from kivy.uix.gridlayout import GridLayout
from kivy.uix.widget import Widget
from kivy.uix.textinput import TextInput
from kivy.uix.popup import Popup
from kivy.utils import get_color_from_hex
from kivy.clock import Clock
import random
from kivy.event import EventDispatcher
from kivy.properties import NumericProperty

# Safety: some recovered bytecode calls `bind` with None callbacks which
# raises AssertionError in Kivy. Wrap EventDispatcher.bind to ignore None
# callback values so the desktop runner can start while we recover source.
_orig_event_bind = EventDispatcher.bind
def _safe_event_bind(self, *args, **kwargs):
    try:
        return _orig_event_bind(self, *args, **kwargs)
    except AssertionError:
        try:
            # filter out any None callback values from kwargs
            filtered = {k: v for k, v in kwargs.items() if v is not None}
            return _orig_event_bind(self, **filtered)
        except Exception:
            return None

try:
    EventDispatcher.bind = _safe_event_bind
except Exception:
    try:
        # Some Kivy builds expose EventDispatcher as an immutable C type.
        # Fall back to patching `Widget.bind` so instances use the safe wrapper.
        Widget.bind = _safe_event_bind
    except Exception:
        # Give up silently; runtime will use original behavior.
        pass

# Emulate mobile window size for desktop preview
from kivy.core.window import Window
try:
    Window.size = (360, 800)
except Exception:
    pass

class StockbitTab(BoxLayout):
    def __init__(self, title, content, **kwargs):
        super().__init__(orientation='vertical', **kwargs)
        # Header ala Stockbit
        header = BoxLayout(orientation='vertical', size_hint_y=None, height=70, padding=(0,0,0,0), spacing=0)
        title_label = Label(text=f'[b]{title}[/b]', markup=True, font_size=22, color=(1,1,1,1), size_hint_y=None, height=38, halign='center', valign='middle')
        header.add_widget(title_label)
        header.add_widget(Widget(size_hint_y=None, height=8))
        self.add_widget(header)
        self.add_widget(content)


class SwipeToDeleteRow(Widget):
    dx = NumericProperty(0)

    def __init__(self, content, on_delete=None, delete_width=110, **kwargs):
        super().__init__(**kwargs)
        from kivy.uix.floatlayout import FloatLayout
        self.size_hint_y = None
        self.height = kwargs.get('height', 92)
        self._delete_width = delete_width
        self._on_delete = on_delete
        self._touch_start_x = None
        self._start_dx = 0
        self._dragging = False

        self._root = FloatLayout()
        self.add_widget(self._root)

        self._delete_btn = Button(
            text='Hapus',
            size_hint=(None, 1),
            width=self._delete_width,
            pos_hint={'right': 1, 'y': 0},
            background_normal='',
            background_color=(0.92, 0.26, 0.20, 1),
            color=(1, 1, 1, 1),
        )
        self._root.add_widget(self._delete_btn)

        self._content = content
        self._content.size_hint = (None, None)
        self._content.height = self.height
        self._root.add_widget(self._content)

        def _sync_layout(*_):
            self._root.pos = self.pos
            self._root.size = self.size
            self._delete_btn.height = self.height
            self._delete_btn.x = self.x + self.width - self._delete_width
            self._delete_btn.y = self.y
            self._content.size = (self.width, self.height)
            self._content.pos = (self.x + self.dx, self.y)

        self.bind(pos=_sync_layout, size=_sync_layout, dx=_sync_layout)
        _sync_layout()

        def _do_delete(_):
            if callable(self._on_delete):
                try:
                    self._on_delete()
                except Exception:
                    pass
        self._delete_btn.bind(on_press=_do_delete)

    def on_touch_down(self, touch):
        if not self.collide_point(*touch.pos):
            return super().on_touch_down(touch)
        self._touch_start_x = touch.x
        self._start_dx = self.dx
        self._dragging = False
        touch.grab(self)
        return True

    def on_touch_move(self, touch):
        if touch.grab_current is not self:
            return super().on_touch_move(touch)
        if self._touch_start_x is None:
            return True
        delta = touch.x - self._touch_start_x
        if abs(delta) > 10:
            self._dragging = True
        if self._dragging:
            new_dx = self._start_dx + delta
            # constrain: 0 (closed) .. -delete_width (open)
            if new_dx > 0:
                new_dx = 0
            if new_dx < -self._delete_width:
                new_dx = -self._delete_width
            self.dx = new_dx
        return True

    def on_touch_up(self, touch):
        if touch.grab_current is not self:
            return super().on_touch_up(touch)
        touch.ungrab(self)
        # snap
        if self.dx < -self._delete_width * 0.4:
            self.dx = -self._delete_width
        else:
            self.dx = 0
        self._touch_start_x = None
        self._dragging = False
        return True

class WatchlistTab(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', **kwargs)
        from modules.data_fetcher import DataFetcher
        from modules.tradingview_fetcher import fetch_tradingview_snapshot
        self.data_fetcher = DataFetcher()
        self.watchlist = [s['symbol'] for s in self.data_fetcher.sample_stocks]
        # Header like Stockbit screenshot (avatar left, title center, menu right)
        header = BoxLayout(orientation='horizontal', size_hint_y=None, height=72, padding=(12, 10), spacing=8)
        from kivy.graphics import Color, Ellipse
        avatar = Widget(size_hint=(None, None), size=(44, 44))
        with avatar.canvas.before:
            Color(0.18, 0.22, 0.30, 1)
            avatar._circ = Ellipse(pos=avatar.pos, size=avatar.size)
        avatar.bind(pos=lambda *_: setattr(avatar._circ, 'pos', avatar.pos), size=lambda *_: setattr(avatar._circ, 'size', avatar.size))
        header.add_widget(avatar)
        header.add_widget(Widget())
        title = Label(text='[b]Stockbit[/b]', markup=True, font_size=28, color=(1,1,1,1))
        header.add_widget(title)
        header.add_widget(Widget())
        menu_btn = Button(text='⋮', size_hint=(None, None), size=(44, 44), background_normal='', background_color=(0.12, 0.12, 0.12, 1), color=(1,1,1,1))
        header.add_widget(menu_btn)
        self.add_widget(header)

        # Scrollable list
        scroll = ScrollView(bar_width=4)
        self._list = GridLayout(cols=1, spacing=0, size_hint_y=None)
        self._list.bind(minimum_height=self._list.setter('height'))
        scroll.add_widget(self._list)
        self.add_widget(scroll)

        def open_menu(_):
            root = BoxLayout(orientation='vertical', spacing=8, padding=8)
            add_btn = Button(text='Tambah saham', size_hint_y=None, height=44)
            rm_btn = Button(text='Hapus saham', size_hint_y=None, height=44)
            root.add_widget(add_btn)
            root.add_widget(rm_btn)
            popup = Popup(title='Watchlist', content=root, size_hint=(0.8, None), height=180)
            def do_add(__):
                popup.dismiss()
                ti = TextInput(text='', hint_text='Symbol (e.g. BBCA)', multiline=False)
                def ok_add(___):
                    sym = ti.text.strip().upper()
                    if sym and sym not in self.watchlist:
                        self.watchlist.insert(0, sym)
                        refresh()
                    p2.dismiss()
                p2 = Popup(title='Tambah saham', content=BoxLayout(orientation='vertical', children=[ti, Button(text='Tambah', size_hint_y=None, height=44, on_press=ok_add)]), size_hint=(0.85, None), height=160)
                p2.open()
            def do_rm(__):
                popup.dismiss()
                ti = TextInput(text='', hint_text='Symbol to remove', multiline=False)
                def ok_rm(___):
                    sym = ti.text.strip().upper()
                    if sym in self.watchlist:
                        try:
                            self.watchlist.remove(sym)
                        except Exception:
                            pass
                        refresh()
                    p2.dismiss()
                p2 = Popup(title='Hapus saham', content=BoxLayout(orientation='vertical', children=[ti, Button(text='Hapus', size_hint_y=None, height=44, on_press=ok_rm)]), size_hint=(0.85, None), height=160)
                p2.open()
            add_btn.bind(on_press=do_add)
            rm_btn.bind(on_press=do_rm)
            popup.open()
        menu_btn.bind(on_press=open_menu)

        def refresh():
            self._list.clear_widgets()
            # Fetch latest data
            try:
                tvdata = fetch_tradingview_snapshot(self.watchlist)
            except Exception:
                tvdata = {}
            symbol_to_name = {s['symbol']: s.get('company_name', '') for s in getattr(self.data_fetcher, 'sample_stocks', [])}
            row_h = 92

            def make_row(symbol: str):
                d = tvdata.get(symbol, {})
                name = symbol_to_name.get(symbol, '')
                price = d.get('price', '-')
                chg = d.get('change', d.get('change_abs', 0))
                chg_pct = d.get('change_percent', d.get('change_pct', 0))
                try:
                    chg_val = float(chg)
                except Exception:
                    chg_val = 0.0
                color_down = (0.86, 0.25, 0.25, 1)
                color_up = (0.11, 0.75, 0.36, 1)
                chg_color = color_up if chg_val >= 0 else color_down

                row = BoxLayout(orientation='horizontal', padding=(12, 8), spacing=10)
                row.size_hint = (None, None)
                row.height = row_h
                row.width = self.width

                with row.canvas.before:
                    from kivy.graphics import Color, Rectangle
                    Color(0.06, 0.06, 0.06, 1)
                    row._bg = Rectangle(pos=row.pos, size=row.size)
                    Color(0.12, 0.12, 0.12, 1)
                    row._sep = Rectangle(pos=(row.x, row.y), size=(row.width, 1))
                def _upd(*_):
                    row._bg.pos = row.pos
                    row._bg.size = row.size
                    row._sep.pos = (row.x, row.y)
                    row._sep.size = (row.width, 1)
                row.bind(pos=_upd, size=_upd)

                logo = Widget(size_hint=(None, None), size=(52, 52))
                with logo.canvas.before:
                    from kivy.graphics import Color, Ellipse
                    Color(0.22, 0.25, 0.33, 1)
                    logo._e = Ellipse(pos=logo.pos, size=logo.size)
                logo.bind(pos=lambda *_: setattr(logo._e, 'pos', logo.pos), size=lambda *_: setattr(logo._e, 'size', logo.size))
                row.add_widget(logo)

                mid = BoxLayout(orientation='vertical', spacing=2)
                top_line = BoxLayout(orientation='horizontal', size_hint_y=None, height=28, spacing=6)
                sym_lbl = Label(text=f'[b]{symbol}[/b]', markup=True, font_size=24, color=(0.9,0.9,0.9,1), halign='left', valign='middle')
                ref_lbl = Label(text='⟳', font_size=16, color=(0.55,0.55,0.55,1), size_hint_x=None, width=18)
                top_line.add_widget(sym_lbl)
                top_line.add_widget(ref_lbl)
                mid.add_widget(top_line)

                name_lbl = Label(text=name, font_size=16, color=(0.55,0.55,0.55,1), halign='left', valign='middle', size_hint_y=None, height=22)
                try:
                    name_lbl.shorten = True
                    name_lbl.shorten_from = 'right'
                except Exception:
                    pass
                mid.add_widget(name_lbl)
                row.add_widget(mid)

                right = BoxLayout(orientation='vertical', size_hint_x=None, width=140, spacing=2)
                price_lbl = Label(text=str(price), font_size=26, color=(0.85,0.85,0.85,1), halign='right', valign='middle', size_hint_y=None, height=30)
                price_lbl.text_size = (right.width, None)
                change_lbl = Label(text=f'{chg} ({chg_pct}%)', font_size=18, color=chg_color, halign='right', valign='middle', size_hint_y=None, height=26)
                change_lbl.text_size = (right.width, None)
                right.add_widget(price_lbl)
                right.add_widget(change_lbl)
                row.add_widget(right)

                return row

            def delete_symbol(sym):
                if sym in self.watchlist:
                    try:
                        self.watchlist.remove(sym)
                    except Exception:
                        pass
                    refresh()

            for symbol in list(self.watchlist):
                row = make_row(symbol)
                swipe = SwipeToDeleteRow(row, on_delete=lambda s=symbol: delete_symbol(s), height=row_h)
                self._list.add_widget(swipe)

        self.bind(width=lambda *_: refresh())
        Clock.schedule_once(lambda dt: refresh(), 0.1)

    def refresh_table(self, grid):
        grid.clear_widgets()
        from modules.tradingview_fetcher import fetch_tradingview_snapshot
        # Ambil nama perusahaan dari sample_stocks
        symbol_to_name = {s['symbol']: s['company_name'] for s in self.data_fetcher.sample_stocks}
        # Ambil data realtime TradingView
        tvdata = fetch_tradingview_snapshot(self.watchlist)
        # Use fixed row height to match previous device layout and screenshot
        row_h = 56
        # helper to create styled label for table rows
        def make_lbl(txt, size_hint_x=None, font_size=16, color=(1,1,1,1), bold=False, halign='left'):
            lbl = Label(text=txt, size_hint_x=size_hint_x, size_hint_y=None, font_size=font_size, color=color, markup=bold)
            lbl.height = row_h
            lbl.halign = halign
            lbl.valign = 'middle'
            return lbl

        for symbol in self.watchlist:
            d = tvdata.get(symbol, {})
            row = BoxLayout(orientation='horizontal', size_hint_y=None, height=row_h, padding=(8,0))
            # dark row background
            with row.canvas.before:
                from kivy.graphics import Color, Rectangle
                Color(0.06,0.08,0.1,1)
                row._bg = Rectangle(pos=row.pos, size=row.size)
            def _update_row(_, __):
                try:
                    row._bg.pos = row.pos
                    row._bg.size = row.size
                except Exception:
                    pass
            row.bind(pos=_update_row, size=_update_row)

            sym_lbl = make_lbl(symbol, size_hint_x=0.5, font_size=18, color=(0.05,0.8,0.66,1))
            price_lbl = make_lbl(str(d.get('price', '-')), size_hint_x=0.25, font_size=18, color=(0.11,0.75,0.36,1))
            yest_lbl = make_lbl(str(d.get('yesterday', d.get('prev_close', '-'))), size_hint_x=0.25, font_size=16, color=(0.9,0.9,0.9,1))

            row.add_widget(sym_lbl)
            row.add_widget(price_lbl)
            row.add_widget(yest_lbl)
            grid.add_widget(row)

class DashboardTab(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', **kwargs)
        # Implement Top 10 view: list top 10 symbols from sample_stocks and fetch prices
        from modules.data_fetcher import DataFetcher
        from modules.tradingview_fetcher import fetch_tradingview_snapshot
        df = DataFetcher()
        self.add_widget(Label(text='[b]Top 10 Saham[/b]', markup=True, font_size=20, color=(0.2,0.5,1,1), size_hint_y=None, height=48))
        # add refresh controls and list area
        from kivy.uix.anchorlayout import AnchorLayout
        refresh_btn = Button(text='Refresh', size_hint=(None, None), size=(80, 36))
        top_controls = AnchorLayout(size_hint_y=None, height=44, anchor_x='right', anchor_y='top', padding=(8,4))
        top_controls.add_widget(refresh_btn)
        self.add_widget(top_controls)

        scroll = ScrollView()
        grid = GridLayout(cols=1, spacing=6, size_hint_y=None, padding=(8,8))
        grid.bind(minimum_height=grid.setter('height'))
        scroll.add_widget(grid)
        self.add_widget(scroll)

        def populate():
            grid.clear_widgets()
            top = getattr(df, 'sample_stocks', [])[:10]
            symbols = [s.get('symbol') for s in top if s.get('symbol')]
            try:
                tv = fetch_tradingview_snapshot(symbols)
            except Exception:
                tv = {}
            if not symbols:
                for i in range(10):
                    grid.add_widget(Label(text=f'{i+1}. -', size_hint_y=None, height=36, font_size=16))
            else:
                for i, s in enumerate(top[:10]):
                    sym = s.get('symbol', f'#{i+1}')
                    name = s.get('company_name', '')
                    data = tv.get(sym, {})
                    price = data.get('price', '-')
                    change = data.get('change_percent', data.get('change', '-'))
                    lbl = Label(text=f"{i+1}. {sym} — {name}  |  {price}  ({change})", size_hint_y=None, height=36, font_size=16)
                    # enable shorten to avoid overflow
                    try:
                        lbl.shorten = True
                        lbl.shorten_from = 'right'
                    except Exception:
                        pass
                    grid.add_widget(lbl)

        # wire refresh button and auto-refresh every 30s
        refresh_btn.bind(on_press=lambda *_: populate())
        try:
            Clock.schedule_interval(lambda dt: populate(), 30)
        except Exception:
            pass
        # initial populate
        populate()

class CekSahamTab(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', **kwargs)
        from modules.tradingview_fetcher import fetch_tradingview_snapshot
        self.add_widget(Label(text='[b]Cek Emiten[/b]', markup=True, font_size=20, color=(0.2,0.5,1,1), size_hint_y=None, height=48))
        # search input + button
        search_row = BoxLayout(orientation='horizontal', size_hint_y=None, height=44, padding=(8,8), spacing=8)
        ti = TextInput(text='', hint_text='Symbol (e.g. BBCA)', multiline=False)
        btn = Button(text='Cek', size_hint_x=None, width=80)
        search_row.add_widget(ti)
        search_row.add_widget(btn)
        self.add_widget(search_row)
        # result area
        self.result_area = BoxLayout(orientation='vertical')
        self.add_widget(self.result_area)
        def do_check(_):
            sym = ti.text.strip().upper()
            self.result_area.clear_widgets()
            if not sym:
                self.result_area.add_widget(Label(text='Masukkan symbol', size_hint_y=None, height=40))
                return
            try:
                data = fetch_tradingview_snapshot([sym]).get(sym, {})
            except Exception:
                data = {}
            price = data.get('price', '-')
            prev = data.get('prev_close', '-')
            vol = data.get('volume', '-')
            self.result_area.add_widget(Label(text=f'Symbol: {sym}', size_hint_y=None, height=36))
            self.result_area.add_widget(Label(text=f'Harga sekarang: {price}', size_hint_y=None, height=36))
            self.result_area.add_widget(Label(text=f'Penutupan kemarin: {prev}', size_hint_y=None, height=36))
            self.result_area.add_widget(Label(text=f'Volume: {vol}', size_hint_y=None, height=36))
        btn.bind(on_press=do_check)

class ScreeningTab(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', **kwargs)
        self.add_widget(Label(text='[b]Hasil Screening[/b]', markup=True, font_size=20, color=(0.2,0.5,1,1), size_hint_y=None, height=48))
        self.add_widget(Label(text='[Hasil screening saham]', font_size=16, color=(0.7,0.7,0.7,1)))

class InvestasiTab(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', **kwargs)
        # Portfolio view: reuse Watchlist styling to show holdings
        from modules.data_fetcher import DataFetcher
        df = DataFetcher()
        self.add_widget(Label(text='[b]Portfolio Saya[/b]', markup=True, font_size=20, color=(0.2,0.5,1,1), size_hint_y=None, height=48))
        scroll = ScrollView()
        grid = GridLayout(cols=1, spacing=6, size_hint_y=None, padding=(8,8))
        grid.bind(minimum_height=grid.setter('height'))
        scroll.add_widget(grid)
        self.add_widget(scroll)
        holdings = getattr(df, 'portfolio_stocks', None) or getattr(df, 'sample_stocks', [])[:5]
        if not holdings:
            grid.add_widget(Label(text='Tidak ada portfolio', size_hint_y=None, height=40))
        else:
            for h in holdings:
                sym = h.get('symbol', '-')
                name = h.get('company_name', '')
                grid.add_widget(Label(text=f'{sym} — {name}', size_hint_y=None, height=48))

class MainStockbitApp(App):
    def build(self):
        # Bottom navigation labels requested by user
        self.tab_names = ['Watchlist', 'Top 10', 'Portfolio', 'Screening', 'Cek Emiten']
        # Map new labels to existing tab factories. Use DashboardTab for Top 10,
        # InvestasiTab for Portfolio, and CekSahamTab for Cek Emiten.
        self.tab_factories = [WatchlistTab, DashboardTab, InvestasiTab, ScreeningTab, CekSahamTab]
        # Icons (emoji fallback) for visual clarity
        self.tab_icons = ['⭐', '🔥', '💼', '🔎', '🏢']
        # start with Top 10 visible so changes are obvious on preview
        self.current_tab = 1
        root = BoxLayout(orientation='vertical')
        # Remove top header for a cleaner desktop preview; add small spacer
        from kivy.uix.widget import Widget
        spacer = Widget(size_hint_y=None, height=6)
        root.add_widget(spacer)

        # Tab container (content area)
        self.tab_container = BoxLayout(orientation='vertical')
        root.add_widget(self.tab_container)
        # show initial tab (Top 10) for preview
        try:
            self.switch_tab(self.current_tab)
        except Exception:
            # fallback to Watchlist if Top 10 fails
            try:
                self.switch_tab(0)
            except Exception:
                pass
        # Bottom navigation ala Stockbit (vertical icon + label buttons)
        from kivy.graphics import Color, Rectangle
        nav = BoxLayout(orientation='horizontal', size_hint_y=None, height=104, spacing=0)
        # draw background and top border
        with nav.canvas.before:
            Color(0.10, 0.10, 0.10, 1)
            nav._bg = Rectangle(pos=nav.pos, size=nav.size)
            Color(0.22, 0.22, 0.22, 1)
            nav._top = Rectangle(pos=(nav.x, nav.y + nav.height - 1), size=(nav.width, 1))
        def _update_nav(_, __):
            nav._bg.pos = nav.pos
            nav._bg.size = nav.size
            nav._top.pos = (nav.x, nav.y + nav.height - 1)
            nav._top.size = (nav.width, 1)
        nav.bind(pos=_update_nav, size=_update_nav)

        nav_buttons = []
        def make_nav(icon_text, label_text, handler, active=False):
            # IMPORTANT: Button is not a Layout; adding children won't auto-position/size them.
            # Use markup text so icon + label are guaranteed to render.
            b = Button(
                text=f"[b][size=30]{icon_text}[/size][/b]\n[size=16]{label_text}[/size]",
                markup=True,
                background_normal='',
                background_color=(0.10, 0.10, 0.10, 1),
                size_hint_x=1,
            )
            b.halign = 'center'
            b.valign = 'middle'
            # keep centered when resized
            try:
                b.text_size = b.size
                b.bind(size=lambda inst, val: setattr(inst, 'text_size', val))
            except Exception:
                pass

            def set_active(state: bool):
                if state:
                    # active color (green-ish like Stockbit)
                    b.background_color = (0.06, 0.14, 0.10, 1)
                    b.color = (0.11, 0.75, 0.36, 1)
                else:
                    b.background_color = (0.10, 0.10, 0.10, 1)
                    b.color = (0.88, 0.88, 0.88, 1)

            def _on_press(instance, *_):
                for other in nav_buttons:
                    try:
                        other.set_active(False)
                    except Exception:
                        pass
                set_active(True)
                try:
                    handler()
                except Exception:
                    pass

            b.set_active = set_active
            b.bind(on_press=_on_press)
            set_active(active)
            nav_buttons.append(b)
            return b

        # choose icons: use plain ASCII so they always render
        icons = ['W', 'T', 'P', 'S', 'E']
        labels = self.tab_names
        # bottom nav handlers must capture index in loop (use default arg)
        for i in range(len(labels)):
            handler = (lambda idx=i: self.switch_tab(idx))
            btn = make_nav(icons[i], labels[i], handler, active=(i==self.current_tab))
            nav.add_widget(btn)

        root.add_widget(nav)
        return root
    def switch_tab(self, idx):
        # Remove existing children and instantiate a fresh tab widget via factory.
        self.tab_container.clear_widgets()
        try:
            factory = self.tab_factories[idx]
            widget = factory()
            self.tab_container.add_widget(widget)
            self.current_tab = idx
        except Exception:
            # Fallback: if something goes wrong, leave container empty and re-raise
            self.tab_container.clear_widgets()
            raise

# Entry point for main.py
JurnalSahamApp = MainStockbitApp
